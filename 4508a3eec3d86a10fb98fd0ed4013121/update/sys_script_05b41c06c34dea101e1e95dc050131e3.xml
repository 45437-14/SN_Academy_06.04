        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var prefix = "POST";
    var tableName = 'x_1650712_4dot_m_0_employer_branding';
    var nextNumber = 1;

    var gr = new GlideRecord(tableName);
    gr.addQuery('number', 'STARTSWITH', prefix);
    gr.orderByDesc('sys_created_on');
    gr.setLimit(1);
    gr.query();

    if (gr.next()) {
        var lastNumber = gr.getValue('number');
        var numericPart = parseInt(lastNumber.substring(prefix.length), 10);
        if (!isNaN(numericPart)) {
            nextNumber = numericPart + 1;
        }
    }

    current.number = prefix + nextNumber.toString().padStart(5, '0');
})(current, previous);]]></script>
